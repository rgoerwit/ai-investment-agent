# Multi-Agent Investment Analysis System - Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Google Gemini API Key (required only when a reachable chat or embedding binding
# uses Google)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Finnhub API Key (Required)
# Get your key from: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Tavily API Key (Required)
# Get your key from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# MULTI-PROVIDER LLM BINDINGS
# =============================================================================

# Groups are the vendor-adversarial boundary. Bull and Bear both stay in BASE;
# Consultant, Forensic Auditor, and Editor stay together in REVIEW. Swap the
# first two values to reverse which vendor performs base versus adversarial work.
LLM_BASE_PROVIDER=google
LLM_REVIEW_PROVIDER=openai
LLM_REGIONAL_PROVIDER=deepseek
LLM_WRITER_PROVIDER=anthropic
LLM_OPERATIONAL_PROVIDER=google
LLM_JUDGE_PROVIDER=google

# Provider-scoped model profiles. Model IDs are plain vendor IDs; this project
# intentionally does not use LangChain's provider:model notation.
GOOGLE_LLM_FAST_MODEL=gemini-3.1-flash-lite
GOOGLE_LLM_REASONING_MODEL=gemini-3-pro-preview
GOOGLE_LLM_CRITICAL_MODEL=gemini-3.1-pro-preview
OPENAI_LLM_FAST_MODEL=gpt-5.4-mini
OPENAI_LLM_REASONING_MODEL=gpt-5.4
OPENAI_LLM_CRITICAL_MODEL=gpt-5.4
OPENAI_LLM_ESCALATION_MODEL=gpt-5.6-sol
# Moonshot/Kimi K3 is reviewed for the REVIEW plane only. It is not a generic
# claim that arbitrary OpenAI-compatible models can run the base fleet.
MOONSHOT_LLM_FAST_MODEL=kimi-k3
MOONSHOT_LLM_REASONING_MODEL=kimi-k3
MOONSHOT_LLM_CRITICAL_MODEL=kimi-k3
MOONSHOT_LLM_ESCALATION_MODEL=kimi-k3
MOONSHOT_API_KEY=
MOONSHOT_API_BASE=https://api.moonshot.ai/v1
# Anthropic remains writer-only until analytical-seat qualification is recorded.
ANTHROPIC_LLM_PROSE_MODEL=claude-opus-4-6
DEEPSEEK_LLM_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
ZAI_LLM_REASONING_MODEL=glm-5.2
ZAI_API_KEY=
ZAI_API_BASE=https://api.z.ai/api/paas/v4/

# Provider runtime policy. These conservative application-side ceilings get
# independent runtime buckets. Raise them only after checking account quota.
GOOGLE_RPM_LIMIT=15
GOOGLE_SERVICE_TIER=standard
OPENAI_RPM_LIMIT=120
# A service tier is an OpenAI pricing/queueing product. It is ignored entirely
# when OPENAI_API_BASE names a non-OpenAI host — do not reach for flex to buy a
# compatible vendor more time; that is the timeout below.
OPENAI_SERVICE_TIER=auto
# Optional. Only an OpenAI-owned host is accepted under provider-scoped
# bindings; point a compatible vendor at its own *_API_BASE instead. This does
# not affect embeddings, which are never routed by it.
# OPENAI_API_BASE=
# How long an OpenAI-*compatible* client may wait. Applies to the legacy
# consultant/auditor/editor path and the provider-scoped compatible adapter
# alike, so both schemas agree. ~4x the slowest kimi-k3 call measured to date.
OPENAI_COMPATIBLE_CLIENT_TIMEOUT_SECONDS=300
ANTHROPIC_RPM_LIMIT=60
DEEPSEEK_RPM_LIMIT=30
ZAI_RPM_LIMIT=30
MOONSHOT_RPM_LIMIT=60

# Optional seat modes are independent. required fails startup without a usable
# binding; auto disables honestly when unavailable; off never constructs it.
LLM_CONSULTANT_MODE=auto
LLM_AUDITOR_MODE=auto
LLM_EDITOR_MODE=auto
LLM_APAC_MODE=off

# Independence is enforced by default. To collapse a boundary, set the matching
# boolean false and persist a non-empty justification. A retained historical
# reason is inactive and harmless while the requirement remains true.
LLM_REQUIRE_REVIEW_INDEPENDENCE=true
LLM_REVIEW_INDEPENDENCE_WAIVER_REASON=
LLM_REQUIRE_REGIONAL_INDEPENDENCE=true
LLM_REGIONAL_INDEPENDENCE_WAIVER_REASON=

# Advanced exact-seat pins, encoded as JSON objects. Normally leave empty.
LLM_SEAT_MODEL_OVERRIDES={}
LLM_SEAT_QUICK_MODEL_OVERRIDES={}
LLM_SEAT_REASONING_OVERRIDES={}
LLM_SEAT_QUICK_REASONING_OVERRIDES={}

# Embeddings are independent of chat bindings. Changing any identity component
# creates a new fingerprinted Chroma collection and never deletes the old one.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_SCHEMA_VERSION=1

# =============================================================================
# OPTIONAL DATA SOURCE API KEYS (Improve international stock coverage)
# =============================================================================

# Alpha Vantage API Key (Optional - free tier: 25 requests/day)
# High-quality fundamentals for international stocks
# Get your key from: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# FMP - Financial Modeling Prep (Optional - fallback in case Yahoo is missing data)
FMP_API_KEY=your_fmp_key_here

# EODHD - You need to get the (more expensive) plan that includes fundamentals data
EODHD_API_KEY=your_eodhd_key_here

# =============================================================================
# OFFICIAL FILING APIs (Optional — free registration, structured filing data)
# =============================================================================

# Japan EDINET API Key (free registration required)
# Provides: major shareholders, segment breakdowns, filing-level cash flow
# Register at: https://disclosure2.edinet-fsa.go.jp
EDINET_API_KEY=

# Korea DART API Key (free from FSS) — Phase 2
# DART_API_KEY=

# UK Companies House API Key (free, 600 req/5min) — Phase 2
# COMPANIES_HOUSE_API_KEY=

# =============================================================================
# CONSULTANT NODE CONFIGURATION (Optional - Cross-validation)
# =============================================================================

# OpenAI API Key (Optional - for external consultant node)
# The consultant uses a different LLM (OpenAI) to cross-validate Gemini's work
# This helps detect biases and groupthink that a single model might miss
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API base URL (Optional). Leave blank/commented to use the default.
# Provider-scoped mode accepts only a reviewed OpenAI-owned host and preserves
# Responses API behavior. Configure Moonshot with MOONSHOT_API_BASE above.
# Legacy mode may still point this at a NON-OpenAI provider, but then you MUST change:
#   - OPENAI_API_KEY  (to that provider's key)
#   - CONSULTANT_MODEL and CONSULTANT_QUICK_MODEL
#   - AUDITOR_MODEL, AUDITOR_QUICK_MODEL, and AUDITOR_ESCALATION_MODEL
#   - EDITOR_MODEL
# A legacy non-OpenAI base uses Chat Completions and must not be combined with
# OPENAI_SERVICE_TIER=flex.
# OPENAI_API_BASE=https://api.moonshot.cn/v1

# Model to use for consultant reviews (external validation).
# Current GPT-5.6 API IDs: gpt-5.6-sol (flagship), gpt-5.6-terra
# (balanced), and gpt-5.6-luna (cost-sensitive). Normal mode uses medium
# reasoning effort; keep the lower-cost gpt-5.4 default until an A/B justifies
# moving a role to GPT-5.6.
# Legacy compatibility only: CONSULTANT_MODEL=gpt-5.4

# Enable/disable consultant node (set to false to skip consultant review)
# When disabled, the graph skips the consultant and routes directly from Research Manager to Trader
# Legacy compatibility only: ENABLE_CONSULTANT=true

# Optional MCP support for narrow consultant cross-checks.
# Copy config/mcp_servers.example.json to config/mcp_servers.json and then
# point MCP_SERVERS_PATH at that local file.
MCP_ENABLED=false
CONSULTANT_MCP_ENABLED=false
MCP_SERVERS_PATH=./config/mcp_servers.json
MCP_USAGE_DB_PATH=./runtime/mcp_usage.db

# Analogous to QUICK_MODEL below (used for Gemini)
# Legacy compatibility only: CONSULTANT_QUICK_MODEL=gpt-5.4-mini
CONSULTANT_TOOLS_IN_QUICK=false
CONSULTANT_QUICK_TOTAL_TIMEOUT_SECONDS=35
CONSULTANT_QUICK_MAX_COMPLETION_TOKENS=4096

# Full forensic auditor; normal mode uses medium reasoning effort.
# Legacy compatibility only: AUDITOR_MODEL=gpt-5.4

# Auditor model for --quick screening runs (defaults to gpt-5.4-mini).
# Quick mode uses low reasoning effort for current GPT-5.x models, including
# gpt-5.6-sol, gpt-5.6-terra, and gpt-5.6-luna. The same rule applies to
# CONSULTANT_QUICK_MODEL.
# Legacy compatibility only: AUDITOR_QUICK_MODEL=gpt-5.4-mini

# Used only as a bounded second-pass reviewer
# Legacy compatibility only: AUDITOR_ESCALATION_MODEL=gpt-5.6-sol

# Bounded forensic retrieval defaults. Raise deliberately; all are hard caps.
AUDITOR_SEARCH_CALL_BUDGET=3
AUDITOR_DOCUMENT_BUDGET=2
# Optional exact issuer/IR domains, comma-separated (for example: issuer.com)
AUDITOR_OFFICIAL_DOCUMENT_HOSTS=
AUDITOR_MAX_DOCUMENT_BYTES=15000000
AUDITOR_MAX_DOCUMENT_PAGES=250
AUDITOR_MAX_SELECTED_PAGES=12
AUDITOR_MAX_EVIDENCE_CHARS=35000
AUDITOR_MAX_TOOL_ITERATIONS=2
AUDITOR_MAX_LLM_CALLS=4

# =============================================================================
# APAC REGIONAL SPECIALIST CONFIGURATION (Optional)
# =============================================================================

# Optional APAC-focused regional audit. Always bypassed in --quick mode.
# The agent itself decides when to emit NO_MATERIAL_APAC_CONNECTION based on
# the supplied payload (listing, supply-chain, customer, regulatory, FX, or
# commodity channels), so US-listed tickers with APAC exposure are still
# audited rather than skipped on suffix alone.
# Legacy compatibility only: ENABLE_APAC_SPECIALIST=false
# Legacy compatibility only: APAC_SPECIALIST_API_KEY=
# Legacy compatibility only: APAC_SPECIALIST_MODEL=deepseek-v4-pro
# Legacy compatibility only: APAC_SPECIALIST_BASE_URL=https://api.deepseek.com

# Model for Editor-in-Chief article revision (optional)
# The editor fact-checks and tightens Gemini-generated articles
# Uses CONSULTANT_MODEL as fallback if not set
# Legacy compatibility only: EDITOR_MODEL=gpt-5.4

# =============================================================================
# WRITER CONFIGURATION (Anthropic Claude)
# =============================================================================

# Anthropic API Key (Optional — falls back to Gemini writer if missing)
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Model for article writing (defaults to claude-opus-4-6)
# Alternatives: claude-sonnet-4-5, claude-haiku-4-5
# Legacy compatibility only: WRITER_MODEL=claude-opus-4-6

# =============================================================================
# LANGSMITH CONFIGURATION (Optional - for observability and tracing)
# =============================================================================

# LangSmith API Key
# Get your key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here

# LangSmith Workspace ID (Required if using org-scoped API key)
# Find your workspace ID in LangSmith Settings → Workspaces
# This should be a UUID, not "default"
LANGSMITH_WORKSPACE_ID=your_workspace_uuid_here

# Enable/disable LangSmith tracing:
#   Set to false to disable tracing; true sends metrics to LangSmith
#   for debugging/monitoring
LANGSMITH_TRACING=false

# LangSmith project name (optional)
LANGSMITH_PROJECT=multi-agent-trading

# LangSmith endpoint (optional)
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
# Hide traced prompts/responses in sensitive deployments if needed
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# =============================================================================
# LANGFUSE CONFIGURATION (Optional - Open Source Alternative to LangSmith)
# =============================================================================

# Enable Langfuse tracing (set to true to enable)
# Langfuse provides open-source LLM observability with self-hosting option
LANGFUSE_ENABLED=false

# Langfuse API Keys
# Get your keys from: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here

# Langfuse Base URL
# EU (default): https://cloud.langfuse.com
# US region: https://us.cloud.langfuse.com
# Self-hosted: https://your-langfuse-instance.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Trace sample rate (0.0 to 1.0) - reduce to lower costs in production
# 1.0 = trace all requests, 0.2 = trace 20% of requests
LANGFUSE_SAMPLE_RATE=1.0

# Debug mode for troubleshooting Langfuse integration
LANGFUSE_DEBUG=false

# Environment tag (appears in Langfuse dashboard for filtering)
LANGFUSE_TRACING_ENVIRONMENT=development

# Optional: override session grouping across multiple CLI invocations
# Useful for batch runs that should appear under one Langfuse session
LANGFUSE_SESSION_ID=

# =============================================================================
# MODEL CONFIGURATION (IMPORTANT - Updated Dec 2025)
# =============================================================================

# The system uses a THREE-TIER architecture:
# - QUICK_MODEL: Used by data gathering agents (Market, Social, News, Fundamentals)
#                and synthesis agents in --quick mode.
# - DEEP_MODEL:  Used by synthesis agents (Bull/Bear, Research Manager, Risk
#                Analysts) in normal mode.
# - APEX_MODEL:  Optional pin for the two gate-critical seats — Senior
#                Fundamentals Analyst (DATA_BLOCK rubric arithmetic feeding the
#                hard <50% health/growth gates) and Portfolio Manager (gate
#                checks, override logic, PM_BLOCK contract). These carry the
#                largest, most rule-dense prompts and fail flash-tier models at
#                a steady rate.
#
# QUICK_MODEL=gemini-2.5-flash
# Legacy compatibility only: QUICK_MODEL=gemini-3.1-flash-lite

# Model to use for deep analysis (more thorough, complex reasoning)
# Legacy compatibility only: DEEP_MODEL=gemini-3-pro-preview

# APEX tier (optional; unset = legacy per-seat tiers, pipeline unchanged).
# Full mode: both apex seats use APEX_MODEL (temp 0.1, deep reasoning reserve,
# APEX_THINKING_LEVEL, default "high" — Gemini has no "xhigh").
# --quick mode: the apex seats drop to APEX_QUICK_MODEL when set, else the
# plain QUICK_MODEL floor — quick screening stays cheap; the degradation is an
# accepted trade-off. Recommended: set APEX_QUICK_MODEL one notch above the
# quick fleet (2 calls/run ≈ pennies) since rubric arithmetic misfires have
# occurred in quick mode (145020.KQ).
# APEX_MODEL=gemini-3.1-pro-preview
# APEX_QUICK_MODEL=gemini-3.5-flash
# APEX_THINKING_LEVEL=high

# LLM provider. Default is 'google'. 'openai' is also supported.
# Retired metadata-only key: LLM_PROVIDER=google

# =============================================================================
# SERVICE TIERS (FLEX INFERENCE — 50% cost, higher latency)
# =============================================================================

# Gemini inference tier: "standard" (default) or "flex".
# Flex halves per-token cost on all Gemini 3.x/2.5 models in exchange for
# variable latency (calls may queue 1-15 minutes) and best-effort capacity.
# Applies to ALL Gemini agents in both normal and --quick runs. Timeout
# ceilings (SDK timeouts, hard-timeout caps, consultant budgets) are floored
# automatically while flex is active — expect runs to take longer.
# GEMINI_SERVICE_TIER=flex
# Legacy compatibility only: GEMINI_SERVICE_TIER=standard

# OpenAI service tier for the consultant, auditor, and editor: "auto"
# (default, standard processing) or "flex" (Batch-API pricing, slower).
# The APAC specialist (non-OpenAI backend) is unaffected.
# OPENAI_SERVICE_TIER=flex
# Configured in the multi-provider section above: OPENAI_SERVICE_TIER=auto

# When a flex call exhausts capacity (429/503 after SDK retries), re-issue it
# once at the standard tier (true, default) instead of failing the call.
# Worst case you pay standard price for a few calls; the run always completes.
FLEX_FALLBACK_TO_STANDARD=true

# Minimum per-call wall-clock allowance (seconds) for flex-tier calls.
# Floors every timeout that could otherwise kill a legitimately-queued flex
# call. Vendor guidance: >= 900s (Gemini targets 1-15 min; OpenAI recommends
# a 15-minute client timeout for flex).
FLEX_LLM_TIMEOUT_SECONDS=900

# =============================================================================
# MEMORY SYSTEM CONFIGURATION
# =============================================================================

# Enable persistent learning across analysis runs
# When enabled, agents remember past analyses and improve over time
ENABLE_MEMORY=true

# =============================================================================
# CHROMADB CONFIGURATION
# =============================================================================

# ChromaDB persistence directory (optional)
CHROMA_PERSIST_DIR=./chroma_db

# =============================================================================
# LOGGING AND OUTPUT CONFIGURATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Suppress unnecessary output for cleaner logs
QUIET_MODE=false

# =============================================================================
# UNTRUSTED CONTENT INSPECTION (Optional - prompt-injection hardening)
# =============================================================================

# Enable inspection of untrusted search/social/memory/cached content before it
# is reused in prompts. Recommended initial rollout posture:
#   ENABLED=true, BACKEND=python, MODE=warn, FAIL_POLICY=fail_open
UNTRUSTED_CONTENT_INSPECTION_ENABLED=false

# Backend options:
#   null      - disabled/no-op
#   python    - in-process heuristic detector (recommended starting point)
#   composite - heuristic detector plus selective LLM judge
UNTRUSTED_CONTENT_BACKEND=null

# Inspection action mode:
#   warn      - log findings, pass content through unchanged
#   sanitize  - use sanitized content when the backend provides a safe rewrite
#   block     - replace flagged content with a blocked placeholder
UNTRUSTED_CONTENT_INSPECTION_MODE=warn

# Backend failure policy:
#   fail_open   - preserve original content if the backend errors
#   fail_closed - block content if the backend errors
UNTRUSTED_CONTENT_FAIL_POLICY=fail_open

# Directory for storing analysis results
RESULTS_DIR=./results

# Directory for caching data
DATA_CACHE_DIR=./data_cache

# =============================================================================
# AGENT AND TRADING CONFIGURATION
# =============================================================================

# Maximum number of debate rounds between Bull and Bear agents: 1 or 2.
# Full mode uses this value; --quick forces 1.
MAX_DEBATE_ROUNDS=2

# Enable or disable online tools for agents
ONLINE_TOOLS=true

# =============================================================================
# API AND SYSTEM CONFIGURATION
# =============================================================================

# API request timeout in seconds (per provider SDK call)
API_TIMEOUT=300

# Quick-mode provider SDK timeout in seconds. This intentionally caps quick
# Gemini calls below API_TIMEOUT so screening batches fail/retry in ~2 minutes
# instead of waiting for the generic 5-minute SDK timeout.
QUICK_LLM_API_TIMEOUT_SECONDS=120

# Maximum number of SDK-level retries per LLM call.
# WARNING: high values (≥10) combined with API_TIMEOUT=300 let a single hung
# Gemini call park a worker for ~50 minutes (10 × 300s) before raising. The
# outer invoke_with_rate_limit_handling already retries 3× with backoff, so
# keep this small. Default 2.
API_RETRY_ATTEMPTS=2

# Hard wall-clock cap (seconds) for any one runnable.ainvoke() call. Enforced
# via run_with_hard_timeout in src/agents/runtime.py. If a provider SDK hangs
# past this, the call is force-cancelled and the outer retry loop reattempts.
# Default 120 seconds. This is intentionally tight for screening batches; use a
# local override for manual deep runs that need more headroom.
LLM_CALL_HARD_TIMEOUT_SECONDS=120

# Gemini API rate limit (requests per minute)
# Free tier: 15 RPM | Paid tier (Tier 1): 360 RPM | Tier 2: 1000+ RPM
# Legacy compatibility only: GEMINI_RPM_LIMIT=15

# LLM circuit breaker — fast-fails a (agent, provider, model) when it has hit
# THRESHOLD consecutive hard-timeouts within WINDOW_SECONDS. Defaults are
# conservative; set ENABLED=false to disable entirely.
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_WINDOW_SECONDS=300
LLM_CIRCUIT_BREAKER_COOL_OFF_SECONDS=60

# Maximum characters per Tavily search result (prevents token bloat)
# Default: 7000 chars (~1750 tokens per search)
TAVILY_MAX_CHARS=7000

# System environment ('dev', 'prod', etc.)
ENVIRONMENT=dev

# Directory for agent prompts
PROMPTS_DIR=./prompts

# =============================================================================
# TELEMETRY AND SYSTEM OVERRIDES (Advanced)
# =============================================================================

# Disable ChromaDB anonymous telemetry
DISABLE_CHROMA_TELEMETRY=true

# Enable gRPC fork support (Critical for Apple Silicon/macOS compatibility)
GRPC_ENABLE_FORK_SUPPORT=true

# gRPC poll strategy ('poll' is most compatible for macOS)
GRPC_POLL_STRATEGY=poll

# =============================================================================
# IBKR PORTFOLIO MANAGEMENT (Optional — requires poetry install -E ibkr)
# =============================================================================

# IBKR Account ID
# IBKR_ACCOUNT_ID=U1234567

# OAuth 1.0a credentials (from IBKR Web API settings)
# See: https://ndcdyn.interactivebrokers.com/oauth/?loginType=1&action=OAUTH&clt=0#/configuration
# IBKR_OAUTH_CONSUMER_KEY=YOURKEY9  # 9 characters, A-Z and 0-9, you choose this yourself
# IBKR_OAUTH_ACCESS_TOKEN=your_access_token
## The secret is shown ONCE when you generate the token at the IBKR portal — copy it
## immediately and paste it here. It does NOT expire (only the 24-hr brokerage session
## expires — that session is only needed for --execute, not for read-only reconciliation).
## If blank, portfolio_manager.py will prompt interactively each run.
# IBKR_OAUTH_ACCESS_TOKEN_SECRET=your_access_token_secret

# Paths to RSA *private* key files (PEM format) — two separate key pairs.
# These are the keys you kept locally; the matching PUBLIC keys are what you
# uploaded to the IBKR Client Portal under "OAuth API Keys".
# Both files must start with -----BEGIN RSA PRIVATE KEY----- or
# -----BEGIN PRIVATE KEY----- (NOT -----BEGIN PUBLIC KEY-----).
# IBKR_OAUTH_SIGNATURE_KEY_FP=/path/to/private_signature_key.pem
# IBKR_OAUTH_ENCRYPTION_KEY_FP=/path/to/private_encryption_key.pem

# Diffie-Hellman Parameters (REQUIRED — ibind has no built-in default)
# Generate and upload to IBKR portal:
#   openssl dhparam -outform PEM -out dhparam.pem 2048
# Then point to the file (recommended):
# IBKR_OAUTH_DH_PRIME_FP=/path/to/dhparam.pem
# Or paste the Base64 body from the PEM file directly:
# IBKR_OAUTH_DH_PRIME=

# Portfolio management defaults (canonical defaults in src/ibkr/portfolio_defaults.py)
# IBKR_MAX_ANALYSIS_AGE_DAYS=14
# IBKR_DRIFT_THRESHOLD_PCT=15.0
# IBKR_CASH_BUFFER_PCT=0.03

# Optional: use the IBKR market-data snapshot as an ADVISORY source in the analysis
# data merge (point-in-time ratios + price only — NOT statements). Requires the IBKR
# creds above. When enabled, IBKR is fetched in parallel with the other sources; it
# overrides Yahoo/FMP point-in-time values but defers to EODHD/filings, and any large
# divergence is flagged in _ibkr_advisory_conflicts. Default off — non-IBKR users and
# latency-sensitive batches are completely unaffected. Partial market-data entitlement
# is fine: only the fields IBKR actually returns are used.
# IBKR_DATA_SOURCE_ENABLED=false

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Never commit the .env file to version control
# 2. Keep your API keys secure and rotate them regularly
# 3. Monitor your API usage to avoid unexpected charges
# 4. LangSmith tracing is optional but highly recommended for debugging
# 5. Use QUICK_MODEL for development/testing to save costs
# 6. ENABLE_MEMORY allows agents to learn from past analyses
